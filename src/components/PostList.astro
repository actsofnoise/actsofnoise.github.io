---
interface Post {
  id: string;
  data: {
    title: string;
    subtitle?: string;
    date: Date;
    category: string;
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const formatDate = (value: Date) => value.toLocaleDateString('es-CL', { year: 'numeric', month: 'short', day: 'numeric' });
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-item">
      <div class="post-meta">
        <span>{formatDate(post.data.date)}</span>
        <span class="post-category">{post.data.category}</span>
      </div>
      <div>
        <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
      </div>
    </article>
  ))}
</div>
