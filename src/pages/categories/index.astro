---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'es'));
---
<BaseLayout title="Categorías" current="categories">
  <section class="page">
    <div class="eyebrow">Índice</div>
    <h1>Categorías</h1>
    <p class="lede">Las categorías aparecen automáticamente a partir de las entradas. Crear una nueva no requiere tocar el código.</p>
    <div class="category-grid" style="margin-top:45px">
      {categories.map(([category, count]) => (
        <a class="category-link" href={`/categories/${encodeURIComponent(category)}/`}>
          {category} <span class="category-count">({count})</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
