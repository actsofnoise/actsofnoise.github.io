---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Blog" current="blog">
  <section class="page">
    <div class="eyebrow">Blog</div>
    <h1>Textos</h1>
    <p class="lede">No hay una línea editorial obligatoria. El archivo puede mezclar una reflexión con una ruta en bicicleta, un disco, una fotografía o un proyecto.</p>
    <div style="margin-top:55px">
      {posts.length ? <PostList posts={posts} /> : <p class="empty">Todavía no hay entradas.</p>}
    </div>
  </section>
</BaseLayout>
